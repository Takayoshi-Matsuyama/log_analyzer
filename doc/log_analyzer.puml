title Log Analyzer

interface txtscn.IFileScanner
{
    +filter_file(file_path_name: string): (is_scanning_target: boolean, file_type: string)
}

class txtscn.DefaultFileScanner {}
class app.CustomFileScanner {}

txtscn.IFileScanner <|-- txtscn.DefaultFileScanner
txtscn.IFileScanner <|-- app.CustomFileScanner

interface txtscn.ISingleLineScanner
{
    +scan_line(line: string): void
}

class txtscn.DefaultLineScanner {}
class app.CustomLineScanner {}

txtscn.ISingleLineScanner <|-- txtscn.DefaultLineScanner
txtscn.ISingleLineScanner <|-- app.CustomLineScanner

interface txtscn.IToolFactory
{
    +create_file_scanner(): txtscn.IFileScanner
    +create_line_scanner(): txtscn.ISingleLineScanner
}

class txtscn.DefaultToolFactory {}
class app.CustomToolFactory {}

txtscn.IToolFactory <|-- txtscn.DefaultToolFactory
txtscn.IToolFactory <|-- app.CustomToolFactory

txtscn.DefaultToolFactory --> txtscn.DefaultFileScanner
txtscn.DefaultToolFactory --> txtscn.DefaultLineScanner

app.CustomToolFactory --> app.CustomFileScanner
app.CustomToolFactory --> app.CustomLineScanner

interface txtscn.ITxtScanningService
{
    +register_file_scanner(file_scanner: txtscn.IFileScanner): void
    +register_line_scanner(file_type: string, line_scanner: txtscn.ISingleLineScanner): void
    +scan_files(root_dir_path: string): void
}

class txtscn.TxtScanningService
{
    -file_scanner: txtscn.IFileScanner
    -line_scanner_dict: Dictionary<string, txtscn.ISingleLineScanner>
}

txtscn.ITxtScanningService <|-- txtscn.TxtScanningService
txtscn.TxtScanningService --> txtscn.IFileScanner
txtscn.TxtScanningService --> txtscn.ISingleLineScanner

class PySide6.QMainWindow {}

class txtscn.MainWindow
{
    + __init__(scanning_service: txtscn.ITxtScanningService): void
}

PySide6.QMainWindow <|-- txtscn.MainWindow

class txtscn.ServiceProvider {}

txtscn.ServiceProvider --> txtscn.ITxtScanningService
txtscn.ServiceProvider --> txtscn.TxtScanningService

entity app.setting_json
{
    "tool_factory": "app.CustomToolFactory"
}

class app.FactoryProvider
 {
    +get_tool_factory(): txtscn.IToolFactory
}

app.FactoryProvider --> app.setting_json
app.FactoryProvider --> txtscn.DefaultToolFactory
app.FactoryProvider --> app.CustomToolFactory

class txtscn.FallbackMain
{
    + start(): void
}

txtscn.FallbackMain *-- txtscn.ServiceProvider
txtscn.FallbackMain *-- txtscn.DefaultToolFactory
txtscn.FallbackMain --> txtscn.ITxtScanningService
txtscn.FallbackMain --> txtscn.MainWindow

note "FallbackMain is used when the txtscn library is executed standalone." as N1
N1 .. txtscn.FallbackMain

class app.Main
{
    + start(): void
}

app.Main *-- app.FactoryProvider
app.Main *-- txtscn.ServiceProvider
app.Main --> txtscn.IToolFactory
app.Main --> txtscn.ITxtScanningService
app.Main --> txtscn.MainWindow
txtscn.MainWindow --> txtscn.ITxtScanningService

note "txtscn package is an open source." as N2
N2 .. txtscn
note "app package provides custom implementations that may contain confidential information." as N3
N3 .. app

@enduml
