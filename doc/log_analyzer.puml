title Log Analyzer

interface azlog.IFileAnalyzer
{
    +filter_file(file_path_name: string): (is_analysis_target: boolean, file_type: string)
}

class azlog.DefaultFileAnalyzer {}
class app.CustomFileAnalyzer {}

azlog.IFileAnalyzer <|-- azlog.DefaultFileAnalyzer
azlog.IFileAnalyzer <|-- app.CustomFileAnalyzer

interface azlog.ISingleLineAnalyzer
{
    +filter_line(line: string): boolean
}

class azlog.DefaultLineAnalyzer {}
class app.CustomLineAnalyzer {}

azlog.ISingleLineAnalyzer <|-- azlog.DefaultLineAnalyzer
azlog.ISingleLineAnalyzer <|-- app.CustomLineAnalyzer

interface azlog.IToolFactory
{
    +create_file_filter(): azlog.IFileAnalyzer
    +create_line_analyzer(): azlog.ISingleLineAnalyzer
}

class azlog.DefaultToolFactory {}
class app.CustomToolFactory {}

azlog.IToolFactory <|-- azlog.DefaultToolFactory
azlog.IToolFactory <|-- app.CustomToolFactory

azlog.DefaultToolFactory --> azlog.DefaultFileAnalyzer
azlog.DefaultToolFactory --> azlog.DefaultLineAnalyzer

app.CustomToolFactory --> app.CustomFileAnalyzer
app.CustomToolFactory --> app.CustomLineAnalyzer

class azlog.LogAnalysisService
{
    -line_analyzer_dict: Dictionary<string, azlog.ISingleLineAnalyzer>
    +register_file_filter(file_filter: azlog.IFileAnalyzer): void
    +register_line_analyzer(file_type: string, line_analyzer: azlog.ISingleLineAnalyzer): void
    +scan_files(root_dir_path: string): void
}

azlog.LogAnalysisService --> azlog.IFileAnalyzer
azlog.LogAnalysisService --> azlog.ISingleLineAnalyzer

class PySide6.QMainWindow {}

class azlog.MainWindow {}

PySide6.QMainWindow <|-- azlog.MainWindow

entity app.setting_json
{
    "tool_factory": "app.CustomToolFactory"
}

class app.FactoryProvider
 {
    +get_tool_factory(): azlog.IToolFactory
}

app.FactoryProvider --> app.setting_json
app.FactoryProvider --> azlog.DefaultToolFactory
app.FactoryProvider --> app.CustomToolFactory

class azlog.FallbackMain {}
azlog.FallbackMain --> azlog.DefaultToolFactory
azlog.FallbackMain --> azlog.LogAnalysisService
azlog.FallbackMain --> azlog.MainWindow


class app.Main {}

app.Main --> app.FactoryProvider
app.Main --> azlog.IToolFactory
app.Main --> azlog.LogAnalysisService
app.Main --> azlog.MainWindow
azlog.MainWindow --> azlog.LogAnalysisService

@enduml
