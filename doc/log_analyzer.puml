title Log Analyzer

interface loghelper.IFileAnalyzer
{
    +filter_file(file_path_name: string): (is_analysis_target: boolean, file_type: string)
}

class loghelper.DefaultFileAnalyzer {}

loghelper.IFileAnalyzer <|-- loghelper.DefaultFileAnalyzer

interface loghelper.ISingleLineAnalyzer
{
    +filter_line(line: string): boolean
}

class loghelper.DefaultLineAnalyzer {}

loghelper.ISingleLineAnalyzer <|-- loghelper.DefaultLineAnalyzer


interface loghelper.IToolFactory
{
    +create_file_filter(): loghelper.IFileAnalyzer
    +create_line_analyzer(): loghelper.ISingleLineAnalyzer
}

class loghelper.DefaultToolFactory {}

loghelper.IToolFactory <|-- loghelper.DefaultToolFactory

loghelper.DefaultToolFactory --> loghelper.DefaultFileAnalyzer
loghelper.DefaultToolFactory --> loghelper.DefaultLineAnalyzer

class loghelper.LogAnalysisService
{
    -line_analyzer_dict: Dictionary<string, loghelper.ISingleLineAnalyzer>
    +register_file_filter(file_filter: loghelper.IFileAnalyzer): void
    +register_line_analyzer(file_type: string, line_analyzer: loghelper.ISingleLineAnalyzer): void
    +scan_files(root_dir_path: string): void
}

loghelper.LogAnalysisService --> loghelper.IFileAnalyzer
loghelper.LogAnalysisService --> loghelper.ISingleLineAnalyzer

class PySide6.QMainWindow {}

class loghelper.MainWindow {}

PySide6.QMainWindow <|-- loghelper.MainWindow

entity setting_json
{
    "tool_factory": "loghelper.DefaultToolFactory"
}

class FactoryProvider
 {
    +get_tool_factory(): loghelper.IToolFactory
}

FactoryProvider --> setting_json
FactoryProvider --> loghelper.DefaultToolFactory

class Main {}

Main --> FactoryProvider
Main --> loghelper.IToolFactory
Main --> loghelper.LogAnalysisService
Main --> loghelper.MainWindow
loghelper.MainWindow --> loghelper.LogAnalysisService

@enduml
