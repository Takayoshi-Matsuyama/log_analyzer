title Log Analyzer



interface IFileFilter
{
    +is_analysis_target(filename: string): boolean
}

interface ISingleLineAnalyzer
{
    +analyze_line(line: string): boolean
}

class LogAnalysisService
{
    +register_file_filter(file_filter: IFileFilter): void
    +register_line_analyzer(line_analyzer: ISingleLineAnalyzer): void
    +analyze(root_file_path: String): void
}

class QMainWindow {}

class MainWindow {}

QMainWindow <|-- MainWindow

class Main {}

LogAnalysisService --> IFileFilter
LogAnalysisService --> ISingleLineAnalyzer
Main --> LogAnalysisService
Main --> MainWindow

@enduml
